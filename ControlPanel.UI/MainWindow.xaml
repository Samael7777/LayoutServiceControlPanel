<ui:FluentWindow
    x:Class="ControlPanel.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:models="clr-namespace:ControlPanel.UI.Models"
    xmlns:vm="clr-namespace:ControlPanel.UI.ViewModels"
    x:Name="Root"
    Title="Layout Switcher Control Panel"
    Width="980"
    Height="700"
    MinWidth="860"
    MinHeight="640"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  Cards and surfaces  -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="InsetBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="IconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  Typography  -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="ListTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="EmptyStateStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!--  Service status indicator  -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorNeutralBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Caution">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Layout list item  -->
        <DataTemplate x:Key="LayoutItemTemplate" DataType="{x:Type models:LayoutItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="40"
                    Height="28"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Code}" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Hex}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="LayoutListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="6">
                                <ContentPresenter />
                            </Border>
                            <Border
                                x:Name="AccentBar"
                                Width="3"
                                Height="18"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="2"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Key picker item  -->
        <Style x:Key="KeyListItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Layout Switcher Control Panel"
            Grid.Row="0"
            CanMaximize="False"
            Icon="{ui:SymbolIcon Keyboard24}"
            ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1100" Margin="24,8,24,8">

                <!--  =====================  SERVICE  =====================  -->
                <Border DataContext="{Binding Service}" Style="{StaticResource SectionCardStyle}">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource IconTileStyle}">
                                <ui:SymbolIcon
                                    FontSize="20"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    Symbol="Settings24" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Switcher service" />
                                <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="Autorun task in Windows Task Scheduler" />
                            </StackPanel>

                            <ui:ProgressRing
                                Grid.Column="2"
                                Width="22"
                                Height="22"
                                IsIndeterminate="True"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <Border
                            Height="1"
                            Margin="0,16"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatusDotStyle}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding StatusText}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="22,4,16,0"
                                    Style="{StaticResource SectionSubtitleStyle}"
                                    Text="{Binding StatusDescription}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:Button
                                    MinWidth="100"
                                    Margin="0,0,8,0"
                                    Appearance="Secondary"
                                    Command="{Binding CreateCommand}"
                                    Content="{Binding CreateText}"
                                    Icon="{ui:SymbolIcon Add24}" />
                                <ui:Button
                                    MinWidth="100"
                                    Margin="0,0,8,0"
                                    Appearance="Primary"
                                    Command="{Binding StartCommand}"
                                    Content="Start"
                                    Icon="{ui:SymbolIcon Play24}" />
                                <ui:Button
                                    MinWidth="100"
                                    Margin="0,0,8,0"
                                    Appearance="Secondary"
                                    Command="{Binding StopCommand}"
                                    Content="Stop"
                                    Icon="{ui:SymbolIcon Stop24}" />
                                <ui:Button
                                    MinWidth="100"
                                    Appearance="Secondary"
                                    Command="{Binding DeleteCommand}"
                                    Content="Delete"
                                    Icon="{ui:SymbolIcon Delete24}" />
                            </StackPanel>
                        </Grid>

                        <Border
                            Margin="0,16,0,0"
                            Padding="16,12"
                            Style="{StaticResource InsetBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Last run" />
                                    <TextBlock Style="{StaticResource ValueStyle}" Text="{Binding LastRunText}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Last result" />
                                    <TextBlock Style="{StaticResource ValueStyle}" Text="{Binding LastResultText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ui:InfoBar
                            Margin="0,12,0,0"
                            IsClosable="False"
                            IsOpen="{Binding IsNotElevated, Mode=OneWay}"
                            Message="Creating, deleting and stopping the task requires elevation. Restart the application as administrator."
                            Severity="Informational"
                            Title="Administrator rights required" />

                        <ui:InfoBar
                            Margin="0,12,0,0"
                            IsClosable="False"
                            IsOpen="{Binding IsConfigWarningOpen, Mode=OneWay}"
                            Message="The task is disabled or differs from the expected configuration. Press Repair to fix it."
                            Severity="Warning"
                            Title="Task needs attention" />

                        <ui:InfoBar
                            Margin="0,12,0,0"
                            IsClosable="True"
                            IsOpen="{Binding IsErrorOpen, Mode=TwoWay}"
                            Message="{Binding ErrorMessage}"
                            Severity="Error"
                            Title="Operation failed" />
                    </StackPanel>
                </Border>

                <!--  =====================  LAYOUTS  =====================  -->
                <Border DataContext="{Binding Layouts}" Style="{StaticResource SectionCardStyle}">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource IconTileStyle}">
                                <ui:SymbolIcon
                                    FontSize="20"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    Symbol="Globe24" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Layouts" />
                                <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="Choose which system layouts take part in cyclic switching and in what order" />
                            </StackPanel>

                            <ui:Button
                                Grid.Column="2"
                                Appearance="Transparent"
                                Command="{Binding RefreshCommand}"
                                Icon="{ui:SymbolIcon ArrowSync24}"
                                ToolTip="Re-read system layouts" />
                        </Grid>

                        <Border
                            Height="1"
                            Margin="0,16"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="260" />
                            </Grid.RowDefinitions>

                            <!--  Available  -->
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="2,0,0,8"
                                Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ListTitleStyle}" Text="Available" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="{Binding Available.Count, StringFormat={}({0})}" />
                            </StackPanel>

                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource InsetBorderStyle}">
                                <Grid>
                                    <ListBox
                                        Margin="0,4"
                                        Background="Transparent"
                                        ItemContainerStyle="{StaticResource LayoutListBoxItemStyle}"
                                        ItemTemplate="{StaticResource LayoutItemTemplate}"
                                        ItemsSource="{Binding Available}"
                                        SelectedItem="{Binding SelectedAvailable, Mode=TwoWay}" />
                                    <TextBlock
                                        Style="{StaticResource EmptyStateStyle}"
                                        Text="Every system layout is already in the cycle."
                                        Visibility="{Binding IsAvailableEmpty, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>

                            <!--  Add / Remove  -->
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center">
                                <ui:Button
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,0,8"
                                    Padding="0"
                                    Appearance="Secondary"
                                    Command="{Binding AddCommand}"
                                    Icon="{ui:SymbolIcon ArrowRight24}"
                                    ToolTip="Add to cycled layouts" />
                                <ui:Button
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    Appearance="Secondary"
                                    Command="{Binding RemoveCommand}"
                                    Icon="{ui:SymbolIcon ArrowLeft24}"
                                    ToolTip="Remove from cycled layouts" />
                            </StackPanel>

                            <!--  Cycled  -->
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="2,0,0,8"
                                Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ListTitleStyle}" Text="Cycled" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="{Binding Cycled.Count, StringFormat={}({0})}" />
                            </StackPanel>

                            <Border
                                Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource InsetBorderStyle}">
                                <Grid>
                                    <ListBox
                                        Margin="0,4"
                                        Background="Transparent"
                                        ItemContainerStyle="{StaticResource LayoutListBoxItemStyle}"
                                        ItemTemplate="{StaticResource LayoutItemTemplate}"
                                        ItemsSource="{Binding Cycled}"
                                        SelectedItem="{Binding SelectedCycled, Mode=TwoWay}" />
                                    <TextBlock
                                        Style="{StaticResource EmptyStateStyle}"
                                        Text="No layouts in the cycle yet. Select one on the left and press the arrow."
                                        Visibility="{Binding IsCycledEmpty, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>

                            <!--  Move up / down  -->
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                                <ui:Button
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,0,8"
                                    Padding="0"
                                    Appearance="Secondary"
                                    Command="{Binding MoveUpCommand}"
                                    Icon="{ui:SymbolIcon ArrowUp24}"
                                    ToolTip="Move up" />
                                <ui:Button
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    Appearance="Secondary"
                                    Command="{Binding MoveDownCommand}"
                                    Icon="{ui:SymbolIcon ArrowDown24}"
                                    ToolTip="Move down" />
                            </StackPanel>
                        </Grid>

                        <ui:InfoBar
                            Margin="0,12,0,0"
                            IsClosable="True"
                            IsOpen="{Binding IsErrorOpen, Mode=TwoWay}"
                            Message="{Binding ErrorMessage}"
                            Severity="Error"
                            Title="Could not update layouts" />
                    </StackPanel>
                </Border>

                <!--  =====================  HOTKEY  =====================  -->
                <Border DataContext="{Binding Hotkey}" Style="{StaticResource SectionCardStyle}">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource IconTileStyle}">
                                <ui:SymbolIcon
                                    FontSize="20"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    Symbol="Keyboard24" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Hotkey" />
                                <TextBlock Style="{StaticResource SectionSubtitleStyle}" Text="Key combination that switches to the next layout" />
                            </StackPanel>
                        </Grid>

                        <Border
                            Height="1"
                            Margin="0,16"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <Border
                            MinHeight="64"
                            Padding="14,10"
                            Style="{StaticResource InsetBorderStyle}">
                            <Grid>
                                <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Chips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:HotkeyChip}">
                                            <StackPanel Margin="0,3" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="10,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="+"
                                                    Visibility="{Binding HasLeadingPlus, Converter={StaticResource BoolToVis}}" />
                                                <Border
                                                    Padding="12,6"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1,1,1,2"
                                                    CornerRadius="6"
                                                    ToolTip="{Binding Hex}">
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding Name}" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="No hotkey assigned"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <StackPanel
                            Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <ui:Button
                                MinWidth="100"
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                Command="{Binding ClearCommand}"
                                Content="Clear"
                                Icon="{ui:SymbolIcon Dismiss24}" />

                            <Grid>
                                <ui:Button
                                    x:Name="AddKeyButton"
                                    MinWidth="100"
                                    Appearance="Primary"
                                    Command="{Binding OpenKeyPickerCommand}"
                                    Content="Add"
                                    Icon="{ui:SymbolIcon Add24}" />

                                <Popup
                                    x:Name="KeyPopup"
                                    AllowsTransparency="True"
                                    HorizontalOffset="-115"
                                    IsOpen="{Binding IsKeyPickerOpen, Mode=TwoWay}"
                                    Opened="KeyPopup_Opened"
                                    Placement="Top"
                                    PlacementTarget="{Binding ElementName=AddKeyButton}"
                                    PopupAnimation="Fade"
                                    StaysOpen="False"
                                    VerticalOffset="4">
                                    <Border
                                        Width="340"
                                        Margin="12"
                                        Padding="12"
                                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="18"
                                                Direction="270"
                                                Opacity="0.35"
                                                ShadowDepth="3" />
                                        </Border.Effect>

                                        <StackPanel>
                                            <TextBlock
                                                Margin="2,0,0,8"
                                                Style="{StaticResource ListTitleStyle}"
                                                Text="Choose a key" />

                                            <ui:TextBox
                                                x:Name="KeySearchBox"
                                                Icon="{ui:SymbolIcon Search24}"
                                                PlaceholderText="Search by name or code"
                                                Text="{Binding KeySearch, UpdateSourceTrigger=PropertyChanged}" />

                                            <Grid Margin="0,8,0,0">
                                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding FilteredKeys}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type models:KeyItem}">
                                                                <Button
                                                                    Command="{Binding DataContext.Hotkey.SelectKeyCommand, ElementName=Root}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource KeyListItemButtonStyle}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock FontSize="14" Text="{Binding Name}" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            Style="{StaticResource CaptionStyle}"
                                                                            Text="{Binding Hex}" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <TextBlock
                                                    Style="{StaticResource EmptyStateStyle}"
                                                    Text="No matching keys."
                                                    Visibility="{Binding IsNoKeysFound, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>

                        <ui:InfoBar
                            Margin="0,12,0,0"
                            IsClosable="True"
                            IsOpen="{Binding IsErrorOpen, Mode=TwoWay}"
                            Message="{Binding ErrorMessage}"
                            Severity="Error"
                            Title="Could not save the hotkey" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
